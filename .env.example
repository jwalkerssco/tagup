# Copy to .env for local development. In production these are real
# platform secrets, never committed.
DATABASE_URL=postgres://user:pass@host:5432/tagup
SESSION_SECRET=change-me-run-openssl-rand-hex-32
APP_URL=https://tagup.app
PORT=3000
# Optional -- without it, brand recognition falls back to Title Case and
# logo search stores the top unverified hit, same fallback the embedded
# product used.
ANTHROPIC_API_KEY=

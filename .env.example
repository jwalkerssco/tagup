# Copy to .env for local development. In production these are real
# platform secrets, never committed. `node dev.js` needs none of them.
DATABASE_URL=postgres://user:pass@host:5432/tagup
SESSION_SECRET=change-me-run-openssl-rand-hex-32
APP_URL=https://tagup.app
PORT=3000

# Outbound mail (verify / reset / invite links). Absent = links print to the
# server console and /api/health reports mail:"console".
POSTMARK_TOKEN=
MAIL_FROM=tagup <hello@tagup.app>

# Optional -- without it, brand recognition falls back to Title Case and
# logo search stores the top unverified hit for a person to approve.
ANTHROPIC_API_KEY=
